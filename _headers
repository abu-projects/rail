# HTML is revalidated; avoid stale pages after a deployment.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json", </agent/api.md>; rel="service-doc"; type="text/markdown", </.well-known/ai-catalog.json>; rel="ai-catalog"

/.well-known/*
  Access-Control-Allow-Origin: *
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
/agent/*.md
  Content-Type: text/markdown; charset=utf-8
/.well-known/agent-skills/rail-cycles-catalog/SKILL.md
  Content-Type: text/markdown; charset=utf-8
/auth.md
  Content-Type: text/markdown; charset=utf-8

# Photos can be replaced at the same URL, so use a bounded cache lifetime.
/assets/*
  Cache-Control: public, max-age=604800

# CSS and JS are requested with content hashes generated by build-site.py.
/home.css
  Cache-Control: public, max-age=31536000, immutable
/home.js
  Cache-Control: public, max-age=31536000, immutable

/404
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
/en/404
  X-Robots-Tag: noindex
/en/404.html
  X-Robots-Tag: noindex
